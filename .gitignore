# 1. Dependency Directories (패키지 매니저 관련)
node_modules/
.pnpm-debug.log*

# 2. Build & Output (빌드 및 컴파일 결과물)
dist/
/artifacts/

# 3. Environment & Secrets (보안 및 환경 변수 파일 - 절대 깃에 올리면 안 됨)
.env
.env.production
.env.development
.env.local
*.local

# 4. Testing & Coverage (테스트 결과 및 커버리지)
coverage/
.vitest/

# 5. JetBrains IDEs (IntelliJ / WebStorm 등 에디터 설정)
.idea/
*.iml

# 6. Runtime & OS Metadata (시스템 임시 파일)
.DS_Store
Thumbs.db
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# 7. TypeScript Build Info (빌드 캐시 - 추가할 내용)
*.tsbuildinfo